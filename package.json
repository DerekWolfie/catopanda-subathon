{
  "name": "catopanda-subathon",
  "version": "0.4.6",
  "private": true,
  "type": "module",
  "description": "Cronômetro, metas e overlays de subathon para OSC Flow Studio 0.5.x",
  "repository": {
    "type": "git",
    "url": "https://github.com/DerekWolfie/catopanda-subathon.git"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:host-contract": "node --experimental-strip-types --test tests/host/*.test.mjs",
    "validate": "node scripts/validate.mjs",
    "check": "node --check plugin/index.mjs && node --check plugin/overlay.js && npm run validate && npm test",
    "prepackage": "npm run check",
    "package": "node sdk/ofs-package.mjs pack plugin --out dist",
    "catalog": "node scripts/build-catalog.mjs",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
